{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">
{{- $baseURL := .Site.BaseURL -}}
{{- $currentDate := now.Format "2006-01-02T15:04:05-07:00" -}}
{{- /* Add homepage with highest priority and hreflang alternates */ -}}
  <url>
    <loc>{{ $baseURL }}</loc>
    <xhtml:link rel="alternate" hreflang="en" href="{{ $baseURL }}"/>
    <xhtml:link rel="alternate" hreflang="ja" href="{{ $baseURL }}ja/"/>
    <xhtml:link rel="alternate" hreflang="fr" href="{{ $baseURL }}fr/"/>
    <xhtml:link rel="alternate" hreflang="hi" href="{{ $baseURL }}hi/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ $baseURL }}"/>
    <lastmod>{{ $currentDate }}</lastmod>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
{{- /* Add main section pages with hreflang alternates */ -}}
  <url>
    <loc>{{ $baseURL }}about-us/</loc>
    <xhtml:link rel="alternate" hreflang="en" href="{{ $baseURL }}about-us/"/>
    <xhtml:link rel="alternate" hreflang="ja" href="{{ $baseURL }}ja/about-us/"/>
    <xhtml:link rel="alternate" hreflang="fr" href="{{ $baseURL }}fr/about-us/"/>
    <xhtml:link rel="alternate" hreflang="hi" href="{{ $baseURL }}hi/about-us/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ $baseURL }}about-us/"/>
    <lastmod>{{ $currentDate }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>{{ $baseURL }}history/</loc>
    <xhtml:link rel="alternate" hreflang="en" href="{{ $baseURL }}history/"/>
    <xhtml:link rel="alternate" hreflang="ja" href="{{ $baseURL }}ja/history/"/>
    <xhtml:link rel="alternate" hreflang="fr" href="{{ $baseURL }}fr/history/"/>
    <xhtml:link rel="alternate" hreflang="hi" href="{{ $baseURL }}hi/history/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ $baseURL }}history/"/>
    <lastmod>{{ $currentDate }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>{{ $baseURL }}ai/</loc>
    <xhtml:link rel="alternate" hreflang="en" href="{{ $baseURL }}ai/"/>
    <xhtml:link rel="alternate" hreflang="ja" href="{{ $baseURL }}ja/ai/"/>
    <xhtml:link rel="alternate" hreflang="fr" href="{{ $baseURL }}fr/ai/"/>
    <xhtml:link rel="alternate" hreflang="hi" href="{{ $baseURL }}hi/ai/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ $baseURL }}ai/"/>
    <lastmod>{{ $currentDate }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>{{ $baseURL }}games/</loc>
    <xhtml:link rel="alternate" hreflang="en" href="{{ $baseURL }}games/"/>
    <xhtml:link rel="alternate" hreflang="ja" href="{{ $baseURL }}ja/games/"/>
    <xhtml:link rel="alternate" hreflang="fr" href="{{ $baseURL }}fr/games/"/>
    <xhtml:link rel="alternate" hreflang="hi" href="{{ $baseURL }}hi/games/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ $baseURL }}games/"/>
    <lastmod>{{ $currentDate }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>{{ $baseURL }}designlab/</loc>
    <xhtml:link rel="alternate" hreflang="en" href="{{ $baseURL }}designlab/"/>
    <xhtml:link rel="alternate" hreflang="ja" href="{{ $baseURL }}ja/designlab/"/>
    <xhtml:link rel="alternate" hreflang="fr" href="{{ $baseURL }}fr/designlab/"/>
    <xhtml:link rel="alternate" hreflang="hi" href="{{ $baseURL }}hi/designlab/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ $baseURL }}designlab/"/>
    <lastmod>{{ $currentDate }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>{{ $baseURL }}store/</loc>
    <xhtml:link rel="alternate" hreflang="en" href="{{ $baseURL }}store/"/>
    <xhtml:link rel="alternate" hreflang="ja" href="{{ $baseURL }}ja/store/"/>
    <xhtml:link rel="alternate" hreflang="fr" href="{{ $baseURL }}fr/store/"/>
    <xhtml:link rel="alternate" hreflang="hi" href="{{ $baseURL }}hi/store/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ $baseURL }}store/"/>
    <lastmod>{{ $currentDate }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>{{ $baseURL }}press/</loc>
    <xhtml:link rel="alternate" hreflang="en" href="{{ $baseURL }}press/"/>
    <xhtml:link rel="alternate" hreflang="ja" href="{{ $baseURL }}ja/press/"/>
    <xhtml:link rel="alternate" hreflang="fr" href="{{ $baseURL }}fr/press/"/>
    <xhtml:link rel="alternate" hreflang="hi" href="{{ $baseURL }}hi/press/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ $baseURL }}press/"/>
    <lastmod>{{ $currentDate }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
{{- /* Search page excluded from sitemap (noindex) */ -}}
{{- /* Add LLM documentation files */ -}}
  <url>
    <loc>{{ $baseURL }}llms.txt</loc>
    <lastmod>{{ $currentDate }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  <url>
    <loc>{{ $baseURL }}llms-full.txt</loc>
    <lastmod>{{ $currentDate }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
{{- /* Add all URLs from home.yaml */ -}}
{{- $data := partial "get-data.html" . -}}
{{- range $data.home.categories -}}
  {{- range .items -}}
    {{- $absoluteURL := partial "home/sitemap-url.html" (dict "url" .url "baseURL" $baseURL) -}}
    {{- /* Only include internal URLs in sitemap */ -}}
    {{- if and $absoluteURL (hasPrefix $absoluteURL $baseURL) -}}
  <url>
    <loc>{{ $absoluteURL }}</loc>
    <lastmod>{{ $currentDate }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- /* Add all URLs from ai.yaml */ -}}
{{- if $data.ai -}}
  {{- if $data.ai.data -}}
    {{- range $data.ai.data -}}
      {{- if .url -}}
        {{- $absoluteURL := partial "home/sitemap-url.html" (dict "url" .url "baseURL" $baseURL) -}}
        {{- if and $absoluteURL (hasPrefix $absoluteURL $baseURL) -}}
  <url>
    <loc>{{ $absoluteURL }}</loc>
    <lastmod>{{ $currentDate }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- /* Add all URLs from games.yaml */ -}}
{{- if $data.games -}}
  {{- if $data.games.data -}}
    {{- range $data.games.data -}}
      {{- if .url -}}
        {{- $absoluteURL := partial "home/sitemap-url.html" (dict "url" .url "baseURL" $baseURL) -}}
        {{- if and $absoluteURL (hasPrefix $absoluteURL $baseURL) -}}
  <url>
    <loc>{{ $absoluteURL }}</loc>
    <lastmod>{{ $currentDate }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- /* Add all URLs from designlab.yaml */ -}}
{{- if $data.designlab -}}
  {{- if $data.designlab.data -}}
    {{- range $data.designlab.data -}}
      {{- if .url -}}
        {{- $absoluteURL := partial "home/sitemap-url.html" (dict "url" .url "baseURL" $baseURL) -}}
        {{- if and $absoluteURL (hasPrefix $absoluteURL $baseURL) -}}
  <url>
    <loc>{{ $absoluteURL }}</loc>
    <lastmod>{{ $currentDate }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- /* Add all URLs from store.yaml */ -}}
{{- if $data.store -}}
  {{- if $data.store.data -}}
    {{- range $data.store.data -}}
      {{- if .url -}}
        {{- $absoluteURL := partial "home/sitemap-url.html" (dict "url" .url "baseURL" $baseURL) -}}
        {{- if and $absoluteURL (hasPrefix $absoluteURL $baseURL) -}}
  <url>
    <loc>{{ $absoluteURL }}</loc>
    <lastmod>{{ $currentDate }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- /* Add section pages not explicitly listed above (cfddc, browse, about sub-sections, etc.) */ -}}
{{- $explicitSections := slice
  (print $baseURL)
  (print $baseURL "about-us/")
  (print $baseURL "history/")
  (print $baseURL "ai/")
  (print $baseURL "games/")
  (print $baseURL "designlab/")
  (print $baseURL "store/")
  (print $baseURL "press/")
-}}
{{- range where site.Pages "Kind" "section" -}}
  {{- if and (ne .Section "search") (ne .Draft true) (not (in $explicitSections .Permalink)) -}}
  {{- $lastmodDate := $currentDate -}}
  {{- if .Lastmod -}}
    {{- $formatted := .Lastmod.Format "2006-01-02T15:04:05-07:00" -}}
    {{- if not (hasPrefix $formatted "0001-01-01") -}}
      {{- $lastmodDate = $formatted -}}
    {{- end -}}
  {{- end -}}
  <url>
    <loc>{{ .Permalink }}</loc>
    <lastmod>{{ $lastmodDate }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  {{- end -}}
{{- end -}}
{{- /* Add content pages */ -}}
{{- range where site.Pages "Kind" "page" -}}
  {{- if and (ne .Permalink "") (ne .Draft true) -}}
  {{- $lastmodDate := $currentDate -}}
  {{- if .Lastmod -}}
    {{- $formatted := .Lastmod.Format "2006-01-02T15:04:05-07:00" -}}
    {{- if not (hasPrefix $formatted "0001-01-01") -}}
      {{- $lastmodDate = $formatted -}}
    {{- end -}}
  {{- end -}}
  <url>
    <loc>{{ .Permalink }}</loc>
    <lastmod>{{ $lastmodDate }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  {{- end -}}
{{- end -}}
</urlset>
